---
import LabriLayout from '../../layouts/LabriLayout.astro';
import Hero from '../../components/Hero.svelte';
import ContactSection from '../../components/ContactSection.svelte';
import menuData from '../../data/menu.json';

// NOTE: this static import and extraction are PERMANENT, not legacy.
// They seed the island's build-time SSR render — the HTML that public
// visitors and search engines receive. Do not remove in later cleanup;
// the grep hit for menu.json on this page is by design (Option 2
// hybrid: static master + admin-only live draft override).
const contactSection = menuData.subMenus.find(s => s.subMenu === 'Contact L\'Abri');
---

<LabriLayout title="Contact L'Abri">
  <Hero 
    title="CONTACT"
    subtitle="L'ABRI"
    backgroundImage={import.meta.env.BASE_URL + "images/contact.avif"}
    height="h-[400px]"
    showBrushStroke={false}
    color="white"
  />

  <section class="max-w-4xl">
    <!-- Hybrid Preview Island: static SSR for the public, draft
         override for a logged-in admin. client:visible — below the
         400px hero, so hydration defers until scroll into view. -->
    <ContactSection client:visible contactSection={contactSection} />
</section>
</LabriLayout>
