---
import LabriLayout from '../../layouts/LabriLayout.astro';
import Hero from '../../components/Hero.svelte';
---

<LabriLayout title="Giving">
  <Hero 
    title="GIVING TO"
    subtitle="L'ABRI"
    backgroundImage={import.meta.env.BASE_URL + "images/giving.avif"}
    height="h-[400px]"
    showBrushStroke={false}
    color="white"
  />

  <!-- INTRO TEXT SECTION -->
  <section class="max-w-4xl">
    <h3>Giving to the Ideas Library</h3>
    <p >
      <!-- EDIT: replace this text with the actual giving/donation content -->
      We want to make the ideas in this library available to everyone, regardless of 
      ability to pay.
    </p>
    <p >
      If you would like to make a donation to support the Ideas Library and the work 
      of L'Abri Fellowship we are very thankful.
    </p>
    <p class="text-center"> 
    <!-- DONATION SECTION -->
    <!-- EDIT: replace the PayPal button with your actual donation integration -->
      <!-- Placeholder for PayPal button or donation form  -->
      <a class="inline-block overflow-hidden transition hover:opacity-90" data-testid="linkElement" href="https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&amp;hosted_button_id=37LAMMDKCPE2L&amp;source=url" target="_blank">
          <img 
            src={import.meta.env.BASE_URL + "images/paypal.png"}
            alt="Donate with Paypal"
            class="h-18 object-cover"
          />  
      </a>
    </p>
  </section>




  
