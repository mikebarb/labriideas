---
import LabriLayout from '../../layouts/LabriLayout.astro';
import TopicsTree from '../../components/TopicsTree.svelte';
import Hero from '../../components/Hero.svelte';
---

<LabriLayout title="Topics">
  <Hero
    title="Browse <strong>Topics</strong>"
    subtitle ="Explore the lecture library by category"
    backgroundImage={import.meta.env.BASE_URL + "images/topics.avif"}
    height="h-[350px]"
    showBrushStroke={false}
    color="white"
  />
  <div class="max-w-2xl mx-auto px-4 py-8">
    <TopicsTree client:load />
  </div>
</LabriLayout>
