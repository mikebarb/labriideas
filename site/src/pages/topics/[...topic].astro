---
import LabriLayout from '../../layouts/LabriLayout.astro';
import { slugify } from '../../lib/slugify.ts';
import menuData from '../../data/menu.json';
import TopicView from '../../components/TopicView.svelte';

// Explicit route shape — keeps TypeScript happy end to end.
// NOTE: declared at frontmatter top level (not inside getStaticPaths)
// so it can be referenced in the function's return-type annotation.
// This is TYPE-ONLY — unlike the earlier "hierarchy is not defined"
// bug (a runtime data issue), types are erased at build time, so
// Astro's getStaticPaths isolation is unaffected.
interface TopicRoute {
  params: { topic: string };
  props: {
    topicName: string;
    filterCategories: string[];
    isMajor: boolean;
    majorSlug: string | null;
    majorLabel: string | null;
    subCategories: Array<{ name: string; slug: string }>;
  };
}

export async function getStaticPaths(): Promise<TopicRoute[]> {
  // FIXED: data extraction lives INSIDE getStaticPaths. Astro evaluates
  // this function in its own module scope during the build — variables
  // defined elsewhere in the frontmatter are NOT visible to it.
  const topicsSubMenu: any = menuData.subMenus.find((s: any) => s.subMenu === 'Topics') || {};
  //const hierarchy: Record<string, Record<string, any[]>> = topicsSubMenu.hierarchy || {};
  // CHANGED: hierarchy values are now sub-category NODES ({ lectures, featured? }),
  // not bare leaf arrays.
  const hierarchy: Record<string, Record<string, any>> = topicsSubMenu.hierarchy || {};

  // ── UNION-FILTER HELPERS ──
  // Collect every raw leaf `category` string beneath a sub-category node,
  // deduplicated. Handles both node shapes ({ lectures, featured? } or
  // legacy bare array). 'featured' never appears here because these walk
  // `lectures` only.
  const collectLeafCategories = (node: any): string[] => {
    const leaves: any[] = Array.isArray(node) ? node : (node?.lectures ?? []);
    const out: string[] = [];
    for (const leaf of leaves) {
      if (leaf && leaf.category && !out.includes(leaf.category)) {
        out.push(leaf.category);
      }
    }
    return out;
  };

  // Union of ALL leaf categories across every sub-category under a major
  // theme — the aggregate list the major-theme page displays.
  const collectRootCategories = (rootKey: string): string[] => {
    const out: string[] = [];
    for (const category of Object.keys(hierarchy[rootKey] || {})) {
      if (category === 'featured') continue;
      for (const c of collectLeafCategories(hierarchy[rootKey][category])) {
        if (!out.includes(c)) out.push(c);
      }
    }
    return out;
  };

  const paths: TopicRoute[] = [];

  // Collision guards — one map per route LEVEL.
  const seenFlat = new Map<string, string>();
  const seenRoots = new Map<string, string>();

  const claim = (map: Map<string, string>, slug: string, original: string, context: string): string => {
    const existing = map.get(slug);
    if (existing !== undefined && existing !== original) {
      throw new Error(
        `Slug collision (${context}): "${original}" and "${existing}" both map to "${slug}". ` +
        `Rename one of these in menu.json.`
      );
    }
    map.set(slug, original);
    return slug;
  };

  for (const rootKey of Object.keys(hierarchy)) {
    const rootSlug = claim(seenRoots, slugify(rootKey), rootKey, 'major theme');

    // Collect this root's sub-categories (for the major page's link cloud)
    const subCategories: Array<{ name: string; slug: string }> = [];
    for (const category of Object.keys(hierarchy[rootKey] || {})) {
      // SKIP: 'featured' is curation data inside the node, not a
      // navigable category — it must not generate routes.
      if (category === 'featured') continue;
      subCategories.push({ name: category, slug: slugify(category) });
    }

    // ── LEVEL 1: Major theme → /topics/{rootSlug} ──
    paths.push({
      params: { topic: rootSlug },
      props: {
        topicName: rootKey,
        filterCategories: collectRootCategories(rootKey),
        isMajor: true,
        majorSlug: rootSlug,
        majorLabel: rootKey,
        subCategories
      }
    });

    // ── LEVEL 2: Nested category → /topics/{rootSlug}/{categorySlug} ──
    const perRoot = new Map<string, string>();
    for (const category of Object.keys(hierarchy[rootKey] || {})) {
      // SKIP: 'featured' is curation data inside the node, not a
      // navigable category — it must not generate routes.
      if (category === 'featured') continue;
      const node = hierarchy[rootKey][category];
      const leaves: any[] = Array.isArray(node) ? node : (node?.lectures ?? []);
      const label = (leaves[0] && leaves[0].subtopic) || category;
      const catSlug = claim(perRoot, slugify(category), category, `nested under "${rootKey}"`);

      paths.push({
        params: { topic: `${rootSlug}/${catSlug}` },
        props: {
          topicName: category,
          filterCategories: collectLeafCategories(node),
          isMajor: false,
          majorSlug: rootSlug,
          majorLabel: rootKey,
          subCategories: []
        }
      });

      // ── Flat structural route (may be superseded by a leaf route below) ──
      const flatSlug = slugify(category);
      if (!seenFlat.has(flatSlug)) {
        claim(seenFlat, flatSlug, category, 'flat category');
        paths.push({
          params: { topic: flatSlug },
          props: {
            topicName: label,
            filterCategories: collectLeafCategories(node),
            //filterTopic: category,
            isMajor: false,
            majorSlug: null,
            majorLabel: null,
            subCategories: []
          }
        });
      }
    }
  }

  // ── LEAF-LEVEL FLAT ROUTES: the pages MegaMenu links to ──
  // MegaMenu links using each leaf item's `category` field
  // ("What Does It Mean To Be Human?" etc.) — the old [slug].astro
  // built routes from these. Where a leaf category slug-matches a
  // structural flat route, the LEAF wins (it's the page users click).
  const leafMap = new Map<string, string>();  // raw leaf category -> label
  for (const rootKey of Object.keys(hierarchy)) {
    for (const category of Object.keys(hierarchy[rootKey] || {})) {
      // SKIP: 'featured' is curation data inside the node, not a
      // navigable category — it must not generate routes.
      if (category === 'featured') continue;
      const node = hierarchy[rootKey][category];
      const leaves: any[] = Array.isArray(node) ? node : (node?.lectures ?? []);
      for (const item of leaves) {
        if (item && item.category && !leafMap.has(item.category)) {
          leafMap.set(item.category, item.subtopic || item.category);
        }
      }
    }
  }

  const leafSlugs = new Set<string>();
  for (const rawCategory of leafMap.keys()) leafSlugs.add(slugify(rawCategory));

  const filteredPaths: TopicRoute[] = paths.filter((p: TopicRoute): boolean => {
    // Keep: nested (two-segment) routes, major themes, and flat
    // structural routes whose slug no leaf category claims.
    if (p.params.topic.includes('/')) return true;
    if (p.props.isMajor) return true;
    return !leafSlugs.has(p.params.topic);
  });

  for (const [rawCategory, label] of leafMap.entries()) {
    const slug = claim(seenFlat, slugify(rawCategory), rawCategory, 'leaf category');
    filteredPaths.push({
      params: { topic: slug },
      props: {
        topicName: label,
        filterCategories: [rawCategory],
        isMajor: false,
        majorSlug: null,
        majorLabel: null,
        subCategories: []
      }
    });
  }

  return filteredPaths;
}

//const { topicName, filterTopic, isMajor, majorSlug, majorLabel, subCategories } = Astro.props;
const { topicName, filterCategories, isMajor, majorSlug, majorLabel, subCategories } = Astro.props;

// NEW: the route param — the URL is the source of truth the island
// re-resolves against the draft at runtime.
const topic = Astro.params.topic ?? '';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
---

<LabriLayout title={topicName}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Hybrid Preview Island: this IS the page content, so client:load.
         getStaticPaths stays fully build-time (route existence); the
         island re-resolves the current route's content against the
         draft for a logged-in admin. -->
    <TopicView
      {topic} {topicName} {filterCategories} {isMajor} {majorSlug} {majorLabel}
      {subCategories} {apiBase} client:load
    />
  </div>
</LabriLayout>
