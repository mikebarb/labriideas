---
// src/pages/featured/index.astro
// REFACTORED: The featured grid is now a Svelte island (FeaturedGrid).
//
// ARCHITECTURE NOTES:
// 1. Catalog Hydration: menu.json holds ONLY curation data (filename,
//    image, colors). All track metadata — critically including the R2
//    `hash` — is resolved by FeaturedGrid.svelte at mount time via
//    catalog lookup. This unlocks OPFS caching and offline resilience.
// 2. Svelte Island Pattern: The previous inline script (~100 lines of
//    imperative DOM manipulation and manual store subscriptions) has
//    been replaced by FeaturedGrid/FeaturedCard, which share all action
//    logic with TrackCard via the useTrackActions composable.
// 3. The filename is the unique key across R2, the catalog, and
//    menu.json — an administrator cannot misconfigure it.
import Layout from '../../layouts/LabriLayout.astro';
import menuData from '../../data/menu.json';
import Hero from '../../components/Hero.svelte';
import FeaturedGrid from '../../components/FeaturedGrid.svelte';

// Pull the featured lectures data (with defensive fallback)
const featuredData = menuData.featuredLectures ?? { 
  sectionTitle: "Featured Lectures", 
  sectionSubtitle: "", 
  items: [] 
};
const { sectionTitle, sectionSubtitle, items } = featuredData;
---

<Layout title="Featured Lectures">
  <Hero
    title={sectionTitle}
    subtitle={sectionSubtitle || undefined}
    backgroundImage={import.meta.env.BASE_URL + "images/featured.avif"}
    height="h-[300px]"
    showBrushStroke={false}
  />

  <div class="container mx-auto px-4 py-8">
    <!--
      Svelte island: hydrates featured items with catalog metadata
      (incl. R2 hash) and wires Play / Queue / Download via the shared
      useTrackActions composable. client:load so hydration begins as
      soon as the page loads.
    -->
    <FeaturedGrid {items} client:load />
  </div>
</Layout>
