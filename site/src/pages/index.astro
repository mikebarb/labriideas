---
// src/pages/labri-home.astro
import LabriLayout from '../layouts/LabriLayout.astro';
import Hero from '../components/Hero.svelte';
import QuickLinks from '../components/QuickLinks.svelte';
import BrushStroke from '../components/BrushStroke.svelte';
---

<LabriLayout title="Labri-Home">
    <!-- backgroundImage = ,
    showBrushStroke = true,
    height = "h-[500px]",
    blurBackground = false,
    isSerif = false,
    color = "black",
    tracking = "0.5em" -->
  <div class="relative w-full h-[500px] flex items-center justify-center overflow-hidden">
    <img 
      src={import.meta.env.BASE_URL + "images/labri-home.avif"}
      alt="L'Abri Ideas Library"
      class="absolute inset-0 w-full h-full object-cover"
    />
    
    <!-- <div class="absolute inset-0 bg-black/40"></div> -->

    <div class="relative z-10 inline-flex flex-col items-center justify-center p-8 md:p-12 overflow-visible">
      <div class="absolute translate-x-8 -translate-y-22 w-75 h-50 z-0">
        <BrushStroke 
          color="white"
          className="absolute inset-0 w-full h-full opacity-70 z-0 scale-[2.5] md:scale-[3]" 
        />
      </div>
      <h1 
        class="relative z-10 text-4xl md:text-6xl leading-normal text-center font-light text-black font-serif italic"
      >
        L'Abri Ideas Library
      </h1>



    </div>
  </div>
  <QuickLinks />

  <!-- Intro Text Section -->
  <section class="max-w-3xl mx-auto px-4 pb-20 text-left">
    <p class="text-gray-700 leading-relaxed text-lg">
      Welcome to the L'Abri Ideas Library, the official collection of L'Abri lectures online. 
      The library contains over 2,500 lectures presenting Christian ideas that engage 
      contemporary issues, the history of thought, religious topics, Christian doctrine, 
      personal questions and more. We hope it helps you find both new questions and new answers.
    </p>
    <br>
    <p class="text-gray-700 leading-relaxed text-lg">
      To begin, 
      <a href="/featured" class="underline decoration-1 hover:text-orange-600 transition-colors">
        listen to a few core lectures
      </a>
      , or simply scroll down to 
      <a href="/search/search3/" 
        class="underline decoration-1 hover:text-orange-600 transition-colors">
          search
      </a> 
      the library, 
      <a 
        href="/topics" 
        class="underline decoration-1 hover:text-orange-600 transition-colors"
      >
        browse topics
      </a>
      , see 
      <a 
        href="/featured/" 
        class="underline decoration-1 hover:text-orange-600 transition-colors"
      >
          featured lectures
      </a>
      , or peruse our ever-growing selection of 
      <a 
        href="/playlists" 
        class="underline decoration-1 hover:text-orange-600 transition-colors"
      >
          playlists
      </a>.
    </p>
  </section>
</LabriLayout>
