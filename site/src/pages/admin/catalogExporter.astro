---
import Layout from '../../layouts/LayoutAdmin.astro';
import CatalogExporter from '../../components/admin/CatalogExporter.svelte';
---
<Layout>
  <main class="flex flex-col items-center py-12">
    <h1 class="text-4xl font-bold text-white mb-8 text-center">Catalog Exporter</h1>
    <p class="text-slate-300 mb-8 text-center max-w-lg">Export the current catalog metadata to a CSV file.</p>
    <CatalogExporter client:load />
  </main>
</Layout>
