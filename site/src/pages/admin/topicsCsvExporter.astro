---
import Layout from '../../layouts/LayoutAdmin.astro';
import TopicsCsvExporter from '../../components/admin/TopicsCsvExporter.svelte';
---
<Layout>
  <main class="flex flex-col items-center py-12">
    <h1 class="text-4xl font-bold text-white mb-8 text-center">Export Topics</h1>
    <p class="text-slate-300 mb-8 text-center max-w-lg">
      Export the topics portion of the menu.json file into a excel readable csv file.
    </p>
    <TopicsCsvExporter client:load />
  </main>
</Layout>