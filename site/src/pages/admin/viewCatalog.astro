---
import Layout from '../../layouts/LayoutAdmin.astro';
import CatalogViewer from '../../components/admin/CatalogViewer.svelte'; 
---

<Layout>
    <h1 class="text-4xl font-bold text-cyan-400 mb-6">MP3 Catalog</h1>
    <h1 class="text-4xl font-bold text-white mb-8 text-center">View Catalogue</h1>
    <p class="text-slate-300 mb-8 text-center max-w-lg">Fetch a copy of the catalogue and save to cache if not the latest.</p>
    <CatalogViewer client:load />
</Layout>
