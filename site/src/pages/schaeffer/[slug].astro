---
import LabriLayout from '../../layouts/LabriLayout.astro';
import SchaefferPersonView from '../../components/SchaefferPersonView.svelte';

// Generate static paths for each person in the collection.
// NOTE: the dynamic menu.json import and this extraction are PERMANENT
// (Option 2 hybrid) — they seed SchaefferPersonView's build-time SSR
// render. Route existence stays a build-time decision; draft preview
// works INSIDE each existing route.
export async function getStaticPaths() {
  const data = (await import('../../data/menu.json')).default;
  const people = data.schaefferCollection?.people ?? {};
    if (Object.keys(people).length === 0) {
    throw new Error('Configuration error: "schaefferCollection.people" missing or empty in menu.json');
  }
  // One path per person (e.g., /schaeffer/francis, /schaeffer/edith)
  return Object.keys(people).map(slug => ({
    params: { slug },
    props: { person: (people as Record<string, any>)[slug] }
  }));
}

const { person } = Astro.props;
// Route param is the source of truth at build time.
const slug = Astro.params.slug ?? '';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
---

<LabriLayout title={person.speakerName}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Hybrid Preview Island: this IS the page content, so client:load. -->
    <SchaefferPersonView {person} {slug} {apiBase} client:load />
  </div>
</LabriLayout>
