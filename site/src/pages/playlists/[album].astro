---
import Layout from '../../layouts/LabriLayout.astro';
import TrackList from '../../components/TrackList.svelte';
import menuData from '../../data/menu.json';

export function getStaticPaths() {
  const playlistsMenu = menuData.subMenus.find(s => s.subMenu === 'Playlists');
  
  // Return empty array if Playlists submenu not found
  if (!playlistsMenu || !playlistsMenu.albums) {
    return [];
  }
  
  // CHANGED: skip external-link albums (e.g. "Suggest a Playlist" with
  // linkToForm and no tracks). The index page links these straight to the
  // external form, so a detail page for them is unreachable AND would
  // render "No tracks found" if visited. Previously this emitted an
  // orphan /playlists/suggest-playlist/ route at every build.
  return playlistsMenu.albums
    .filter(album => !album.linkToForm)
    .map(album => ({
    params: { album: album.id },
    props: { album }
  }));
}

const { album } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
---

<Layout title={album.title}>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4 text-gray-900">{album.title}</h1>
    <p class="text-gray-400 mb-8">{album.description}</p>

    <!-- Pass the tracks from menu.json into the Svelte island  -->
    <TrackList tracks={album.tracks} {apiBase} client:load />
  </div>
</Layout>
