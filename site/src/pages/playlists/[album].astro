---
import Layout from '../../layouts/LabriLayout.astro';
import AlbumView from '../../components/AlbumView.svelte';
import menuData from '../../data/menu.json';

export function getStaticPaths() {
  // UNCHANGED — route existence is a build-time decision (see the
  // boundary notes in AlbumView.svelte). The draft preview works INSIDE
  // each existing route; new album ids need a rebuild to gain a page.
  const playlistsMenu = menuData.subMenus.find(s => s.subMenu === 'Playlists');
  
  // Return empty array if Playlists submenu not found
  if (!playlistsMenu || !playlistsMenu.albums) {
    return [];
  }
  
  // NOTE: static import/extraction here are PERMANENT (Option 2 hybrid
  // pattern) — they seed AlbumView's build-time SSR render. Do not remove.
  return playlistsMenu.albums
    .filter(album => !album.linkToForm)
    .map(album => ({
    params: { album: album.id },
    props: { album }
  }));
}

const { album } = Astro.props;
// NEW: pass the route param so the island can locate the matching draft
// album by id. Passes the param (not album.id) deliberately — the URL is
// the source of truth at build time.
const albumId = Astro.params.album ?? album.id;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
---

<Layout title={album.title}>
  <div class="container mx-auto px-4 py-8">
    <!-- Hybrid Preview Island: static SSR for the public, draft override
         for a logged-in admin. client:load — this IS the page content,
         no above-fold hero to defer past. -->
    <AlbumView {album} {albumId} {apiBase} client:load />
  </div>
</Layout>
