---
import Layout from '../../layouts/LabriLayout.astro';
import menuData from '../../data/menu.json';
import Hero from '../../components/Hero.svelte';
import PlaylistsGrid from '../../components/PlaylistsGrid.svelte';

// NOTE: this static import and extraction are PERMANENT (Option 2 hybrid
// pattern) — they seed PlaylistsGrid's build-time SSR render, which is
// what public visitors and search engines receive. Do not remove.
const albums = menuData.subMenus.find(s => s.subMenu === 'Playlists')?.albums ?? [];
---

<Layout title="Playlists">
  <Hero
    title="Playlists"
    subtitle="Selected lectures grouped by theme."
    backgroundImage={import.meta.env.BASE_URL + "images/playlists.avif"}
    height="h-[300px]"
    showBrushStroke={false}
  />
  
  <div class="container mx-auto px-4 py-8">
    <!-- Hybrid Preview Island: static SSR for the public, draft override
         for a logged-in admin. client:visible — below the 300px hero,
         so hydration defers until scroll into view. -->
    <PlaylistsGrid {albums} client:visible />
  </div>
</Layout>
