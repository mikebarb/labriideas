---
// src/layouts/LabriLayout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.svelte';
import MegaMenu from '../components/MegaMenu.svelte';
import Player from '../components/Player.svelte';
import { ClientRouter } from 'astro:transitions';
import AppShell from '../components/AppShell.svelte';

// 1. Import the static configuration
import menuData from '../data/menu.json';

// 2. Extract the Topics hierarchy (with the type guard for safety)
const topicsSubMenu = menuData.subMenus.find(s => s.subMenu === 'Topics');
if (!topicsSubMenu || !topicsSubMenu.hierarchy) {
  throw new Error('Configuration error: "Topics" subMenu with hierarchy not found in menu.json');
}
const topicsHierarchy = topicsSubMenu.hierarchy;
const apiBase = import.meta.env.PUBLIC_API_BASE_URL;

interface Props {
	title: string;
}

const { title } = Astro.props;
const isHome = Astro.url.pathname === '/';
const showMegaMenu = isHome;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | L'Abri Ideas Library</title>
		 <ClientRouter />
	</head>
    <!-- Note the white background and dark text for the L'Abri site -->
	<body class="bg-white text-gray-900 font-sans h-dvh overflow-hidden flex flex-col">
		<Navbar client:load />
		<!-- {showMegaMenu && <MegaMenu client:load />}  -->
		<!-- 3. Pass the hierarchy as a prop instead of letting the component import it -->
    	<!-- {showMegaMenu && <MegaMenu hierarchy={topicsHierarchy} client:load />} -->
		<!-- {showMegaMenu && <MegaMenu client:load />} -->``
		{showMegaMenu && <MegaMenu client:load apiBase={apiBase} isAdmin={true} />}


		<!-- 
			AppShell provides the reactive flex container that 
			'pushes' content when the queue drawer is open.
		-->
		<div class="flex-1 min-h-0 overflow-hidden">
			<AppShell client:load apiBase={import.meta.env.PUBLIC_API_BASE_URL}>
		    	<slot />
			</AppShell>
		</div>

		<!-- 
		    PLAYER: Visible on all pages, controls its own visibility
			Sticky Player Container:
			- `fixed bottom-0 left-0 right-0`: anchors to the bottom of the viewport.
			- `z-50`: keeps it above scrolling page content.
			- `transition:persist`: ensures audio doesn't stop/reload on navigation.
		-->

		<!-- 
			PLAYER: Visible on all pages, controls its own visibility.
			
			CHANGED: Bare wrapper — no positioning, no styling. The Player
			component renders its own backgrounds (dark desktop bar, floating
			mobile pill) and is now an in-flow flex child, so the body column
			gives AppShell exactly the remaining height: page content and the
			queue drawer end at the player's top edge, nothing occluded.
			When no track is loaded, Player renders nothing and this wrapper
			collapses to zero height (no phantom border).
			
			`transition:persist`: moves this DOM node across navigations,
			keeping audio alive — independent of positioning.
		-->
		<div transition:persist="audio-player">
			<Player 
			client:load 
			showTracklist={false} 
			apiBase={import.meta.env.PUBLIC_API_BASE_URL} 
			isAdmin={true} 
			/>
		</div>

        <!-- 
		<div transition:persist="audio-player" class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 shadow-[0_-2px_10px_rgba(0,0,0,0.05)]">
			<Player 
			client:load 
			showTracklist={false} 
			apiBase={import.meta.env.PUBLIC_API_BASE_URL} 
			isAdmin={true} 
			/>
		</div>
		-->
	</body>
</html>